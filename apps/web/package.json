{
  "name": "@hts/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/limpiar-dist.mjs && vite build",
    "build:e2e": "node scripts/limpiar-dist.mjs dist-e2e && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hts/anfitrion": "workspace:*",
    "@hts/bots": "workspace:*",
    "@hts/cards": "workspace:*",
    "@hts/engine": "workspace:*",
    "framer-motion": "^12",
    "react": "^19",
    "react-dom": "^19",
    "socket.io-client": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@hts/server": "workspace:^",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25",
    "tailwindcss": "^4",
    "vite": "^6"
  }
}
