{
  "name": "here-to-slay-es",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm --filter @hts/web dev",
    "build": "pnpm --filter @hts/web build",
    "servidor": "pnpm build && pnpm --filter @hts/server start",
    "empaquetar": "pnpm build && pnpm --filter @hts/server empaquetar",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @hts/web build:e2e && pnpm --filter @hts/e2e e2e",
    "validate:cards": "pnpm --filter @hts/cards validate",
    "copy:images": "pnpm --filter @hts/cards copy-images",
    "recursos": "pnpm --filter @hts/cards recursos",
    "sim": "pnpm --filter @hts/bots sim"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
